<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Filled in by SettingsActivity: one entry per printer plus "Add printer". -->
    <PreferenceCategory
        app:key="printers"
        app:title="@string/category_printers" />

    <PreferenceCategory app:title="@string/category_display">
        <ListPreference
            app:defaultValue="100"
            app:entries="@array/ui_scale_values"
            app:entryValues="@array/ui_scale_values"
            app:key="ui_scale_main"
            app:title="@string/pref_ui_scale_main" />
        <ListPreference
            app:defaultValue="100"
            app:entries="@array/ui_scale_values"
            app:entryValues="@array/ui_scale_values"
            app:key="ui_scale_cover"
            app:title="@string/pref_ui_scale_cover" />
        <ListPreference
            app:defaultValue="top"
            app:entries="@array/bar_position_entries"
            app:entryValues="@array/bar_position_values"
            app:key="bar_position"
            app:title="@string/pref_bar_position"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="keep_screen_on"
            app:summary="@string/pref_keep_screen_on_summary"
            app:title="@string/pref_keep_screen_on" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/category_background">
        <Preference
            app:key="battery"
            app:persistent="false"
            app:title="@string/pref_battery" />
        <EditTextPreference
            app:defaultValue="10"
            app:key="kill_minutes"
            app:title="@string/pref_kill_minutes" />
    </PreferenceCategory>
</PreferenceScreen>
